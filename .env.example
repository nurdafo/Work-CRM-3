DATABASE_URL=sqlite:///./crm.db
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-your-password
POSTGRES_PASSWORD=replace-with-another-strong-password
# Только для первого переноса ADS.KZ командой python -m app.migrate_businesses.
# После переноса подключения редактируются в панели «Бизнесы».
META_LEADS_ACCESS_TOKEN=
META_PAGE_ID=
META_FORM_ID=
META_API_VERSION=v23.0
# Для обратной передачи качественных лидов через Conversions API for CRM
META_DATASET_ID=
META_CAPI_ACCESS_TOKEN=
# Порог CRM для подготовки похожей аудитории
META_LOOKALIKE_MIN_LEADS=20
